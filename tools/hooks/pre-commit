#!/usr/bin/env sh
# atlas-hook v1
# SPEC 034: ATLAS pre-commit — sır taraması + doctor --strict.
#
# `atlas hooks install` bu şablonu `.git/hooks/pre-commit`'e kopyalar.
# `atlas hooks uninstall` ikinci satırdaki `atlas-hook` imzasına bakıp
# ATLAS'ın koyduğu hook olduğunu doğrular.
#
# Değişiklikler burada yapılmalı; `hooks install --force` ile yayılır.
set -e

# 1) Sır taraması — kaynak dizinini tarar.
if ! atlas scan src >&2; then
    echo "" >&2
    echo "[pre-commit] atlas scan başarısız — commit engellendi." >&2
    exit 1
fi

# 2) DECISIONS drift denetimi + env sağlık kontrolü.
if ! atlas doctor --strict; then
    echo "" >&2
    echo "[pre-commit] atlas doctor --strict başarısız — commit engellendi." >&2
    echo "Çözüm: DECISIONS.md'ye günün girişini ekle veya" >&2
    echo "       ATLAS_STRICT_DRIFT_DAYS eşiğini geçici gevşet." >&2
    exit 1
fi

exit 0
