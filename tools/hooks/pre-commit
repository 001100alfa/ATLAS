#!/usr/bin/env sh
# atlas-hook v4
# SPEC 034 + 032.2 + 045 + 052: ATLAS pre-commit — quality gate + sır
# taraması + vault graf sağlığı + auto-dump raporu TEK komut zincirinde.
#
# `atlas hooks install` bu şablonu `.git/hooks/pre-commit`'e kopyalar.
# `atlas hooks uninstall` ikinci satırdaki `atlas-hook` imzasına bakıp
# ATLAS'ın koyduğu hook olduğunu doğrular (versiyon bilinçsiz).
#
# Değişiklikler burada yapılmalı; `hooks install --force` ile yayılır.
set -e

# Kapı 1: DECISIONS drift + entry count + vault health + sır taraması.
if ! atlas doctor --strict --scan-src; then
    echo "" >&2
    echo "[pre-commit] atlas doctor --strict --scan-src başarısız — commit engellendi." >&2
    echo "Çözüm:" >&2
    echo "  - DECISIONS.md'ye günün girişini ekle (drift/entry_count)." >&2
    echo "  - vault/'a en az bir not koy (vault_health)." >&2
    echo "  - src/'te sır varsa temizle (scan_src)." >&2
    echo "  - Geçici gevşetme: ATLAS_STRICT_DRIFT_DAYS / MIN_ENTRIES env." >&2
    exit 1
fi

# Kapı 2 (SPEC 045 + 052): vault graf sağlığı — kırık [[wikilink]] veya
# orfan not/tag. SPEC 052: `--dump-report .atlas/vault-health.md` ile
# başarısızlık durumunda insan-okunur markdown rapor otomatik dosyaya
# yazılır (`.atlas/` git-ignored → commit döngüsü yok). Fresh clone veya
# vault-less proje için nazik: `vault/` dizini yoksa sessizce atla.
if [ -d vault ]; then
    if ! atlas vault verify --strict --dump-report .atlas/vault-health.md; then
        echo "" >&2
        echo "[pre-commit] atlas vault verify --strict başarısız — commit engellendi." >&2
        echo "Detay rapor: .atlas/vault-health.md (auto-dump)" >&2
        echo "Renkli konsol: atlas vault verify (bayraksız)" >&2
        exit 1
    fi
fi

exit 0
